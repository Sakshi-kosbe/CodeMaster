rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public Question Bank - Read-only for authenticated users
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false; // Read-only from client, populated by verified system
    }

    // User Profile Documents
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    // User Progress Aggregation
    match /userProgress/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    // Submissions
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Immutable audit log
    }

    // Daily Challenges
    match /dailyChallenges/{challengeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Revision Queue
    match /revisionQueue/{revisionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
