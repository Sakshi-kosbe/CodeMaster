rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Blueprints
    function isValidUser(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (data.email == null || (data.email is string && data.email.size() <= 200));
    }

    function isValidProgress(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.xp is number && data.xp >= 0
        && data.streak is number && data.streak >= 0
        && data.longestStreak is number && data.longestStreak >= 0;
    }

    function isValidSubmission(data) {
      return data.submissionId is string && data.submissionId.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.questionId is string && data.questionId.size() <= 64
        && data.status is string && (data.status in ['Accepted', 'Wrong Answer', 'Runtime Error', 'Time Limit Exceeded'])
        && data.passedTests is number && data.passedTests >= 0
        && data.totalTests is number && data.totalTests >= 0;
    }

    function isValidDailyChallenge(data) {
      return data.date is string && data.date.size() <= 20
        && data.questionId is string && data.questionId.size() <= 64
        && data.userId is string && data.userId == request.auth.uid;
    }

    function isValidRevision(data) {
      return data.questionId is string && data.questionId.size() <= 64
        && data.userId is string && data.userId == request.auth.uid
        && data.nextReviewDate is string && data.nextReviewDate.size() <= 20
        && data.revisionLevel is number && data.revisionLevel >= 1 && data.revisionLevel <= 10;
    }

    // 2. Public Question Bank - Read-only verified questions
    match /questions/{questionId} {
      allow read: if isValidId(questionId);
      allow list: if true;
      allow write: if false; // System populated only
    }

    // 3. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // 4. User Progress State
    match /userProgress/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidProgress(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidProgress(incoming())
        && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // 5. Code Submissions (Immutable Audit Log)
    match /submissions/{submissionId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(submissionId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(submissionId) && isValidSubmission(incoming());
      allow update, delete: if false; // Immutable audit log
    }

    // 6. Daily Challenges
    match /dailyChallenges/{challengeId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(challengeId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(challengeId) && isValidDailyChallenge(incoming());
      allow update: if isSignedIn() && isValidId(challengeId) && isValidDailyChallenge(incoming())
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 7. Spaced Repetition Revision Queue
    match /revisionQueue/{revisionId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(revisionId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(revisionId) && isValidRevision(incoming());
      allow update: if isSignedIn() && isValidId(revisionId) && isValidRevision(incoming())
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
